# ===== 服务端口 =====
PORT=3000

# ===== 平台适配器 =====
# onebot11  —— 真实 QQ 接入（需自行部署 NapCat / LLOneBot）
ADAPTER=onebot11

# ===== OneBot 11（ADAPTER=onebot11 时生效）=====
# reverse-ws —— 本应用作为 WS 服务端，NapCat 连入（推荐）
# forward-ws —— 本应用作为 WS 客户端连接 NapCat
# http       —— 事件走 WS，发送走 HTTP API
ONEBOT_MODE=reverse-ws
ONEBOT_WS_PORT=3001
ONEBOT_WS_PATH=/onebot/v11/ws
# 与 NapCat 网络配置中的 access token 保持一致（留空则不校验）
ONEBOT_TOKEN=
# 正向 WS 模式要连接的 NapCat 地址
ONEBOT_NAPCAT_WS_URL=
# HTTP API 模式要连接的 NapCat 地址
ONEBOT_HTTP_BASE_URL=

# ===== CodeBuddy Agent SDK 凭据（AI 总结必需）=====
# 留空时：消息采集与页面浏览正常，AI 总结会优雅降级并提示
CODEBUDDY_API_KEY=
CODEBUDDY_AUTH_TOKEN=
CODEBUDDY_BASE_URL=
CODEBUDDY_INTERNET_ENVIRONMENT=

# ===== AI 总结引擎 =====
# 提供方：codebuddy | openai-compatible | ollama
AI_PROVIDER=codebuddy
# 兼容接口示例：https://api.deepseek.com/v1；Ollama：http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
SUMMARY_MODEL=balanced-model
SUMMARY_CHUNK_MESSAGES=30
SUMMARY_CHUNK_CHARS=6000
# 默认总结时间窗（分钟）
SUMMARY_WINDOW_MINUTES=720

# ===== 即时提醒节流 =====
INSTANT_COOLDOWN_MS=300000
INSTANT_PER_MINUTE=10

# ===== 邮件推送（SMTP）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== 时区 =====
TZ=Asia/Shanghai
